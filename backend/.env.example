# --- Server ---
PORT=3000
# Set to production on HTTPS deployments for secure cross-site session cookies.
NODE_ENV=development

# --- Database ---
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# --- Auth ---
# Use long random strings in production
JWT_SECRET=replace_with_a_long_random_secret
COOKIE_SECRET=replace_with_another_long_random_secret

# --- AI provider (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key
# How many past messages are sent to the model as context (default 20)
GEMINI_HISTORY_MESSAGES=20
# How conversation titles are created:
#   local = title is derived from the first message locally (no API call, default)
#   ai    = Gemini writes a short title (uses one extra API call per new chat)
# The Gemini free tier allows only a few requests per day, so "local" is the
# safer choice on a tight quota.
CHAT_TITLE_MODE=local

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- RAG foundation (separate from the chat key) ---
Gemini_API_KEY_for_embedding=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
PDF_MAX_SIZE_MB=20
RAG_TOP_K=5
